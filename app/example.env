# ============================================
# AI News Aggregator - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit your .env file to GitHub!

# --- LLM Provider (Groq - Free Tier) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# --- Email Delivery (Gmail SMTP) ---
# Get an App Password at: https://myaccount.google.com/apppasswords
MY_EMAIL=your_email@gmail.com
APP_PASSWORD=your_gmail_app_password

# --- Database ---
# Set to "true" to use PostgreSQL (requires Docker or hosted DB)
# Set to "false" to use local SQLite (zero setup)
USE_POSTGRES=false
SQLITE_PATH=ai_news_aggregator.db

# --- PostgreSQL (only if USE_POSTGRES=true) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=ai_news_aggregator
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Alternative LLM Providers (optional) ---
# OPENAI_API_KEY=your_openai_key
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_HOST=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
