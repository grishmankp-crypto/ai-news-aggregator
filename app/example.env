# Free LLM API Key (Get yours free from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# (Optional) Alternative LLM Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# (Optional) Email Delivery (If omitted, newsletter is saved to output/latest_digest.html)
MY_EMAIL=
APP_PASSWORD=

# Database Configuration (Defaults to local SQLite - set USE_POSTGRES=true for PostgreSQL)
USE_POSTGRES=false
SQLITE_PATH=ai_news_aggregator.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news_aggregator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


