# ============================================
# AI News Aggregator SaaS - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit your .env file to GitHub!

# --- LLM Provider (Groq - Free Tier) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# --- Transactional Email (Resend - Free Tier: 3,000 emails/month) ---
RESEND_API_KEY=re_your_resend_api_key_here

# --- Email Delivery Fallback (Gmail SMTP) ---
# Get an App Password at: https://myaccount.google.com/apppasswords
MY_EMAIL=your_email@gmail.com
APP_PASSWORD=your_gmail_app_password

# --- Cloud Database (Neon PostgreSQL - Free Tier) ---
# Paste your Neon connection string directly:
DATABASE_URL=postgresql://user:password@ep-something.neon.tech/neondb?sslmode=require
USE_POSTGRES=true

# --- Local SQLite Fallback (if USE_POSTGRES=false) ---
# USE_POSTGRES=false
# SQLITE_PATH=ai_news_aggregator.db

# --- Alternative LLM Providers (optional) ---
# OPENAI_API_KEY=your_openai_key
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_HOST=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
